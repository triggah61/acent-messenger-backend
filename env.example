# Database Configuration
MONGODB_URI=mongodb://localhost:27017/acent-messenger-backend

# Bitcoin Network Configuration
BITCOIN_NETWORK=testnet  # or "mainnet" for production

# Wallet Encryption
WALLET_ENCRYPTION_KEY=your-32-character-encryption-key-here

# Tatum API Configuration
TATUM_API_KEY=your-tatum-api-key-here

# Optional: Platform Fee Configuration
ADMIN_WALLET_ADDRESS=your-admin-wallet-address-for-fees
PLATFORM_FEE_PERCENTAGE=0.005  # 0.5% platform fee

# Optional: Custom Fee Rate (satoshis per byte)
CUSTOM_FEE_RATE=5

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration (if using authentication)
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d 